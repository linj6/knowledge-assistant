<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <conversionRule conversionWord="credentials" class="com.lnjecit.knowledge.assistant.infrastructure.logging.CredentialRedactingConverter"/>
    <conversionRule conversionWord="credentialEx" class="com.lnjecit.knowledge.assistant.infrastructure.logging.CredentialThrowableConverter"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{60} - %credentials%n%credentialEx{full}</pattern>
        </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
