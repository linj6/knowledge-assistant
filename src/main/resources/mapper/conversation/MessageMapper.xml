<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lnjecit.knowledge.assistant.conversation.mapper.MessageMapper">
    <resultMap id="historyMessage" type="com.lnjecit.knowledge.assistant.conversation.entity.Message" autoMapping="true">
        <id property="id" column="id"/>
        <result property="turnId" column="turn_id" typeHandler="com.lnjecit.knowledge.assistant.infrastructure.persistence.UuidTypeHandler"/>
        <result property="citations" column="citations" typeHandler="com.lnjecit.knowledge.assistant.infrastructure.persistence.JsonbTypeHandler"/>
    </resultMap>

    <select id="selectHistory" resultMap="historyMessage">
        SELECT id, conversation_id, turn_id, role, content, status, error_code, citations, created_at, completed_at
        FROM chat_message
        WHERE conversation_id = #{conversationId}
        ORDER BY created_at ASC, id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>
</mapper>
